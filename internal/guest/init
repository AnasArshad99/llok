#!/bin/sh
# llok guest init (PID 1). Runs from the initramfs; the repo is a virtiofs share.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=xterm-256color

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null || mdev -s
mkdir -p /dev/pts /tmp /run
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run

# Kernel modules we need that Alpine's linux-virt ships as modules.
if [ -f /etc/llok/modules ]; then
  while read -r m; do
    [ -n "$m" ] && insmod "$m" 2>/dev/null
  done < /etc/llok/modules
fi

# Out-of-band markers for the host: a private OSC that terminals ignore.
marker() { printf '\033]7777;%s\033\\' "$1"; }

cmdline_val() { sed -n "s/.*$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
b64_val() { v=$(cmdline_val "$1"); [ -n "$v" ] && echo "$v" | base64 -d; }

REPO=$(cmdline_val llok.repo); REPO=${REPO:-/repo}
NAME=$(b64_val llok.name); NAME=${NAME:-project}
COLS=$(cmdline_val llok.cols); ROWS=$(cmdline_val llok.rows)

mkdir -p "$REPO"
MOUNT_STATE="virtiofs, rw"
if ! mount -t virtiofs repo "$REPO"; then
  MOUNT_STATE="FAILED"
  echo "llok: failed to mount repo share" >&2
fi

hostname llok 2>/dev/null
[ -n "$COLS" ] && [ -n "$ROWS" ] && stty -F /dev/hvc0 cols "$COLS" rows "$ROWS" 2>/dev/null

# Shell environment for interactive sessions.
mkdir -p /etc/profile.d
cat > /etc/profile.d/llok.sh <<PROFILE
export TERM=xterm-256color
export LLOK_VM=1
export LLOK_PROJECT="$NAME"
export PS1='\[\e[1;35m\]llok\[\e[0m\]\[\e[2m\]@$NAME\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;35m\]#\[\e[0m\] '
alias ll='ls -la'
PROFILE

marker "LLOK_READY uptime=$(cut -d' ' -f1 /proc/uptime)s"

banner() {
  P='\033[1;35m'; D='\033[2m'; G='\033[32m'; N='\033[0m'
  IF=$(ip -o link 2>/dev/null | wc -l | tr -d ' ')
  MEM=$(awk '/MemTotal/{printf "%d MiB", $2/1024}' /proc/meminfo)
  printf '\n'
  printf "${P}  ██  ██   ██████  ██  ██${N}\n"
  printf "${P}  ██  ██  ██   ██  ████  ${N}   ${D}locked microVM · project${N} ${NAME}\n"
  printf "${P}  ██  ██  ██   ██  ██ ██ ${N}   ${D}kernel${N}  $(uname -r) ${D}on${N} $(uname -m)\n"
  printf "${P}  ██████   ██████  ██  ██${N}   ${D}cpu/mem${N} $(nproc) vCPU · ${MEM}\n"
  printf '\n'
  printf "  ${D}network${N}   ${G}none${N} ${D}(${IF} interface: lo only, no routes)${N}\n"
  printf "  ${D}repo${N}      ${REPO} ${D}(${MOUNT_STATE})${N}\n"
  printf "  ${D}rootfs${N}    initramfs, discarded at power off\n"
  printf "  ${D}exit${N}      type ${G}exit${N} to power off · ${G}Ctrl-] twice${N} forces it from the host\n"
  printf '\n'
}

cd "$REPO" || cd /
CMD_B64=$(cmdline_val llok.cmd)
if [ -n "$CMD_B64" ]; then
  echo "$CMD_B64" | base64 -d > /tmp/llok-cmd.sh
  LLOK_VM=1 LLOK_PROJECT="$NAME" sh /tmp/llok-cmd.sh
  marker "LLOK_EXIT $?"
else
  banner > /dev/hvc0
  setsid sh -c 'exec sh -l </dev/hvc0 >/dev/hvc0 2>&1'
  marker "LLOK_EXIT 0"
fi

sync
poweroff -f
