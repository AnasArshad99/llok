#!/bin/sh
# llok guest init. Runs as PID 1 from the initramfs (stage 1). When a root
# disk is attached it sets up a read-only root + tmpfs overlay and re-executes
# itself after switch_root (stage 2). In build mode it installs the rootfs.
export PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
export TERM=xterm-256color

# Out-of-band markers for the host: a private OSC that terminals ignore.
marker() { printf '\033]7777;%s\033\\' "$1"; }
cmdline_val() { sed -n "s/.*$1=\([^ ]*\).*/\1/p" /proc/cmdline; }
b64_val() { v=$(cmdline_val "$1"); [ -n "$v" ] && echo "$v" | base64 -d; }
die() { echo "llok: $*" >&2; marker "LLOK_EXIT 111"; sync; poweroff -f; }

STAGE=${1:-1}

if [ "$STAGE" = 1 ]; then
  mount -t proc proc /proc
  mount -t sysfs sys /sys
  mount -t devtmpfs dev /dev 2>/dev/null || mdev -s
  mkdir -p /dev/pts /tmp /run
  mount -t devpts devpts /dev/pts
  mount -t tmpfs tmpfs /tmp
  mount -t tmpfs tmpfs /run
  # Kernel modules Alpine's linux-virt ships as modules (ordered by dependency).
  if [ -f /etc/llok/modules ]; then
    while read -r m; do
      [ -n "$m" ] && insmod "$m" 2>/dev/null
    done < /etc/llok/modules
  fi
fi

if [ "$STAGE" = 1 ]; then
  # llok's own read-only share (CA certificate for the broker), if attached.
  mkdir -p /run/llok
  mount -t virtiofs llok /run/llok 2>/dev/null || rmdir /run/llok
fi

MODE=$(cmdline_val llok.mode); MODE=${MODE:-run}
REPO=$(cmdline_val llok.repo); REPO=${REPO:-/repo}
NAME=$(b64_val llok.name); NAME=${NAME:-project}
COLS=$(cmdline_val llok.cols); ROWS=$(cmdline_val llok.rows)
BANNER=$(cmdline_val llok.banner)
BROKER=$(cmdline_val llok.broker); CRED=$(cmdline_val llok.cred)
ROOT=$(cmdline_val llok.root)

# ---- build mode: install the rootfs onto /dev/vda (network allowed) --------
if [ "$MODE" = build ] && [ "$STAGE" = 1 ]; then
  sh /etc/llok/build-rootfs.sh
  rc=$?
  marker "LLOK_EXIT $rc"
  sync
  poweroff -f
fi

# ---- stage 1 with a root disk: read-only root + tmpfs overlay, switch_root --
if [ "$STAGE" = 1 ] && [ "$ROOT" = 1 ]; then
  mkdir -p /rom /overlay /newroot
  mount -t ext4 -o ro /dev/vda /rom || die "cannot mount root disk"
  mount -t tmpfs tmpfs /overlay
  mkdir -p /overlay/upper /overlay/work
  mount -t overlay overlay -o lowerdir=/rom,upperdir=/overlay/upper,workdir=/overlay/work /newroot \
    || die "overlay mount failed"
  mkdir -p /newroot/etc/llok /newroot/usr/local/bin "/newroot$REPO"
  cp /init /newroot/etc/llok/init
  cp /usr/local/bin/llok-guest /newroot/usr/local/bin/llok-guest 2>/dev/null
  mount -t virtiofs repo "/newroot$REPO" || echo "llok: failed to mount repo share" >&2
  for d in dev proc sys run tmp; do
    mkdir -p "/newroot/$d"
    mount --move "/$d" "/newroot/$d"
  done
  exec switch_root /newroot /bin/sh /etc/llok/init 2
fi

# ---- session (stage 2 on a root disk, or stage 1 initramfs-only) -----------
if [ "$STAGE" = 1 ]; then
  mkdir -p "$REPO"
  mount -t virtiofs repo "$REPO" || echo "llok: failed to mount repo share" >&2
  ROOTFS_DESC="initramfs, discarded at power off"
else
  ROOTFS_DESC="$(cat /etc/llok/rootfs-info 2>/dev/null || echo alpine) · overlay, discarded at power off"
fi
MOUNT_STATE="virtiofs, rw"
mountpoint -q "$REPO" || MOUNT_STATE="FAILED"

hostname llok 2>/dev/null
ip link set lo up 2>/dev/null

# The broker: the guest's only way out. llok-guest forwards 127.0.0.1:3128
# over vsock to the host, which decides what may leave and injects the real
# credential. The guest only ever holds a placeholder.
BROKER_ENV=""
if [ "$BROKER" = 1 ] && command -v llok-guest >/dev/null 2>&1; then
  llok-guest proxy >/dev/null 2>&1 &
  BROKER_ENV='export HTTP_PROXY=http://127.0.0.1:3128 HTTPS_PROXY=http://127.0.0.1:3128
export http_proxy=$HTTP_PROXY https_proxy=$HTTPS_PROXY
export NO_PROXY=127.0.0.1,localhost no_proxy=127.0.0.1,localhost
export ANTHROPIC_BASE_URL=http://127.0.0.1:3128
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 DISABLE_AUTOUPDATER=1'
  case "$CRED" in
    oauth)  BROKER_ENV="$BROKER_ENV
export CLAUDE_CODE_OAUTH_TOKEN=llok-placeholder-token" ;;
    *)      BROKER_ENV="$BROKER_ENV
export ANTHROPIC_API_KEY=sk-ant-llok-placeholder" ;;
  esac
  NET_DESC="broker"
  # Trust the llok CA so the broker can terminate TLS for provider hosts.
  if [ -f /run/llok/ca.pem ]; then
    [ -f /etc/ssl/certs/ca-certificates.crt ] && cat /run/llok/ca.pem >> /etc/ssl/certs/ca-certificates.crt
    BROKER_ENV="$BROKER_ENV
export NODE_EXTRA_CA_CERTS=/run/llok/ca.pem SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt"
  fi
else
  NET_DESC="none"
fi
# Skip Claude Code's first-run wizard (theme, sign-in, folder trust): the
# credential comes from the environment and the home dir is fresh every boot.
# The root disk may already carry a .claude.json from the installer, so merge.
mkdir -p /root
if command -v jq >/dev/null 2>&1; then
  { [ -s /root/.claude.json ] && cat /root/.claude.json || echo '{}'; } \
    | jq --arg repo "$REPO" '. + {hasCompletedOnboarding:true, theme:"dark"}
        | .projects = (.projects // {})
        | .projects[$repo] = ((.projects[$repo] // {}) + {hasTrustDialogAccepted:true})' \
    > /tmp/.claude.json 2>/dev/null && mv /tmp/.claude.json /root/.claude.json
else
  printf '{"hasCompletedOnboarding":true,"theme":"dark","projects":{"%s":{"hasTrustDialogAccepted":true}}}\n' "$REPO" > /root/.claude.json
fi

[ -n "$COLS" ] && [ -n "$ROWS" ] && stty -F /dev/hvc0 cols "$COLS" rows "$ROWS" 2>/dev/null

# Shell environment for interactive sessions.
mkdir -p /etc/profile.d
cat > /etc/profile.d/llok.sh <<PROFILE
export PATH=/root/.local/bin:\$PATH
export TERM=xterm-256color
export LLOK_VM=1
export LLOK_PROJECT="$NAME"
export PS1='\[\e[1;35m\]llok\[\e[0m\]\[\e[2m\]@$NAME\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\] \[\e[1;35m\]#\[\e[0m\] '
alias ll='ls -la'
$BROKER_ENV
PROFILE

marker "LLOK_INFO rootfs=$ROOTFS_DESC"
marker "LLOK_READY uptime=$(cut -d' ' -f1 /proc/uptime)s"

banner() {
  P='\033[1;35m'; D='\033[2m'; G='\033[32m'; N='\033[0m'
  IF=$(ip -o link 2>/dev/null | wc -l | tr -d ' ')
  MEM=$(awk '/MemTotal/{printf "%d MiB", $2/1024}' /proc/meminfo)
  printf '\n'
  printf "${P}  ██  ██   ██████  ██  ██${N}\n"
  printf "${P}  ██  ██  ██   ██  ████  ${N}   ${D}locked microVM · project${N} ${NAME}\n"
  printf "${P}  ██  ██  ██   ██  ██ ██ ${N}   ${D}kernel${N}  $(uname -r) ${D}on${N} $(uname -m)\n"
  printf "${P}  ██████   ██████  ██  ██${N}   ${D}cpu/mem${N} $(nproc) vCPU · ${MEM}\n"
  printf '\n'
  printf "  ${D}network${N}   ${G}${NET_DESC}${N} ${D}(${IF} interface: lo only, no routes)${N}\n"
  printf "  ${D}repo${N}      ${REPO} ${D}(${MOUNT_STATE})${N}\n"
  printf "  ${D}rootfs${N}    ${ROOTFS_DESC}\n"
  printf "  ${D}exit${N}      type ${G}exit${N} to power off · ${G}Ctrl-] twice${N} forces it from the host\n"
  printf '\n'
}

SHELL_BIN=/bin/sh
[ -x /bin/bash ] && SHELL_BIN=/bin/bash

cd "$REPO" || cd /
CMD_B64=$(cmdline_val llok.cmd)
if [ -n "$CMD_B64" ]; then
  echo "$CMD_B64" | base64 -d > /tmp/llok-cmd.sh
  LLOK_VM=1 LLOK_PROJECT="$NAME" $SHELL_BIN -c ". /etc/profile.d/llok.sh; . /tmp/llok-cmd.sh"
  marker "LLOK_EXIT $?"
else
  [ "$BANNER" != 0 ] && banner > /dev/hvc0
  setsid sh -c "exec $SHELL_BIN -l </dev/hvc0 >/dev/hvc0 2>&1"
  marker "LLOK_EXIT 0"
fi

sync
poweroff -f
